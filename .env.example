# AdMob IDs for production builds. Copy this file to .env.local (git ignores it)
# and fill in the IDs from your AdMob account. Development builds always use
# Google's test ads, whatever is set here.
ADMOB_APP_ID_ANDROID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
ADMOB_APP_ID_IOS=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
AD_UNIT_REWARDED_BONUSES=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
AD_UNIT_INTERSTITIAL_UNLOCKS=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
AD_UNIT_BANNER=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX

# Force Google's test ads even in a production build (for testing on your own
# phone with real IDs set: never tap real ads on your own device).
# ADMOB_USE_TEST_ADS=1
